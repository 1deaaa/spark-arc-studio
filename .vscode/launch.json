    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server/app.py",
            "args": [],
            "cwd": "${workspaceFolder}/server",
            "env": {
                "WATCHFILES_IGNORE": "**/*.db;**/alembic/versions/**"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Vue Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/client"
        },
        {
            "name": "Tauri Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run tauri:dev",
            "cwd": "${workspaceFolder}/client"
        },
        {
            "name": "Tauri Build",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run tauri:build",
            "cwd": "${workspaceFolder}/client"
        }
    ],
    "compounds": [
        {
            "name": "前后端Dev",
            "configurations": [
                "Server",
                "Vue Dev"
            ]
        },
        {
            "name": "Tauri全栈Dev",
            "configurations": [
                "Server",
                "Tauri Dev"
            ]
        },
        {
            "name": "前后端TauriDev",
            "configurations": [
                "Server",
                "Tauri Dev",
                "Vue Dev"
            ]
        }

    ]
}
