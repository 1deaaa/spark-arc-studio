{
  "name": "sparkarc-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:launcher": "vite --config vite.launcher.config.ts",
    "build": "vite build",
    "build:launcher": "vite build --config vite.launcher.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:scan:full": "node scripts/i18n-scan.mjs --full",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:strict": "node scripts/i18n-check.mjs --strict",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "preview:launcher": "vite preview --config vite.launcher.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build && node scripts/copy-artifacts.mjs desktop",
    "tauri:android": "tauri android build && node scripts/copy-artifacts.mjs android",
    "tauri:ios": "tauri ios build && node scripts/copy-artifacts.mjs ios",
    "prepare-icon": "python ../scripts/prepare-icon.py",
    "patch-android-adaptive-foreground": "python ../scripts/patch-android-adaptive-foreground.py"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@lucide/vue": "^1.17.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@types/three": "^0.184.1",
    "@vueuse/core": "^14.3.0",
    "cn-fontsource-lxgw-wen-kai-screen": "^1.0.6",
    "gsap": "^3.15.0",
    "katex": "^0.16.45",
    "markstream-vue": "^1.0.1-beta.5",
    "mermaid": "^11.15.0",
    "mitt": "^3.0.1",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "stream-markdown": "^0.0.15",
    "three": "^0.184.0",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0",
    "vue-select": "^4.0.0-beta.6",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.3"
  }
}
