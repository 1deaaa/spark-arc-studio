    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server/app.py",
            "args": [],
            "cwd": "${workspaceFolder}/server",
            "env": {
                "WATCHFILES_IGNORE": "**/*.db;**/alembic/versions/**"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Server Production",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/server/app.py",
            "args": [],
            "cwd": "${workspaceFolder}/server",
            "env": {
                "WATCHFILES_IGNORE": "**/*.db;**/alembic/versions/**",
                "SPARKARC_SERVER_TRAY": "1",
                "SPARKARC_SERVER_RELOAD": "0"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Web App Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/client",
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Web App Build",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run build",
            "cwd": "${workspaceFolder}/client",
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Launcher Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run tauri:dev",
            "cwd": "${workspaceFolder}/client",
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Launcher Build",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run tauri:build",
            "cwd": "${workspaceFolder}/client",
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "📦 发布 Windows（本地）",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run tauri:release:windows",
            "cwd": "${workspaceFolder}/client",
            "presentation": {
                "group": "发布",
                "order": 1
            }
        },
        {
            "name": "📱 发布 Android（本地）",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run tauri:release:android",
            "cwd": "${workspaceFolder}/client",
            "presentation": {
                "group": "发布",
                "order": 2
            }
        },
        {
            "name": "✅ 本地快速 Checks（非 Docker）",
            "type": "node-terminal",
            "request": "launch",
            "command": "echo Local fast checks completed",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "PR: 本地 Checks"
        }
    ],
    "compounds": [
        {
            "name": "🌐 前后端 Web Dev",
            "configurations": [
                "Server",
                "Web App Dev"
            ]
        },
        {
            "name": "🪟 前后端 Launcher Dev",
            "configurations": [
                "Server",
                "Web App Build",
                "Launcher Dev"
            ]
        },
        {
            "name": "🏗️ 前端 Build + 后端生产",
            "configurations": [
                "Server Production",
                "Launcher Build"
            ]
        }
    ]
}
