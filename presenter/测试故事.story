              {
                "id": 50007,
                "chr": 3,
                "txt": "（我还是没能说出口……）"
              }
            ]
          },
          {
            "optn": "（画一个圈）我有点难过。",
            "dia": [
              {
                "id": 50008,
                "chr": 2,
                "txt": "为什么？可以告诉我吗？"
              },
              {
                "id": 50009,
