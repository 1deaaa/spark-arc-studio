# ============================================================
# SparkArc 服务端环境变量配置示例
# ============================================================
# 重要提示：
#   1. 复制此文件为 .env（不带 .example 后缀）
#   2. 填入你的真实配置值
#   3. ⚠️ 绝对不要将 .env 文件提交到 Git ⚠️
# ============================================================

# LLM_KEY - API Key 加密/解密主密码
# 用于加密存储在 llm_mgr_cfg.yaml 中的 API Key
# 首次使用时系统会提示你设置此密码
LLM_KEY=

# 以下为可选的平台 API Key 占位符（可在 llm_mgr_cfg.yaml 中使用 {VAR_NAME} 引用）
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx
