{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "SparkArc Studio",
	"version": "0.0.1",
	"identifier": "com.sparkarc.studio",
	"build": {
		"beforeDevCommand": "npm run dev:launcher",
		"beforeBuildCommand": "npm run build:launcher",
		"devUrl": "http://localhost:4173",
		"frontendDist": "../dist-launcher"
	},
	"app": {
		"windows": [
			{
				"title": "SparkArc Studio",
				"width": 1600,
				"height": 900,
				"minWidth": 1600,
				"minHeight": 900,
				"resizable": true,
				"fullscreen": false,
				"decorations": false
			}
		]
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/icon.icns",
			"icons/icon.png",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installerHooks": "./windows/installer-hooks.nsh"
			}
		}
	}
}
