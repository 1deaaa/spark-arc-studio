{
  "name": "sparkarc-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:launcher": "vite --config vite.launcher.config.ts",
    "build": "vite build",
    "build:launcher": "vite build --config vite.launcher.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:scan:full": "node scripts/i18n-scan.mjs --full",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:strict": "node scripts/i18n-check.mjs --strict",
    "test": "vitest run",
    "preview": "vite preview",
    "preview:launcher": "vite preview --config vite.launcher.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build && node scripts/copy-artifacts.mjs desktop",
    "tauri:android": "tauri android build && node scripts/copy-artifacts.mjs android",
    "tauri:ios": "tauri ios build && node scripts/copy-artifacts.mjs ios",
    "prepare-icon": "python ../scripts/prepare-icon.py",
    "patch-android-adaptive-foreground": "python ../scripts/patch-android-adaptive-foreground.py"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource/ma-shan-zheng": "^5.2.9",
    "@fontsource/zcool-xiaowei": "^5.2.8",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@types/three": "^0.183.1",
    "@vueuse/core": "^14.2.1",
    "cn-fontsource-lxgw-wen-kai-screen": "^1.0.6",
    "gsap": "^3.15.0",
    "katex": "^0.16.45",
    "lucide-vue-next": "^0.542.0",
    "mitt": "^3.0.1",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "three": "^0.183.2",
    "vue": "^3.5.18",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.1",
    "vue-select": "^4.0.0-beta.6",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.1"
  }
}
